{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	extends: [
		"config:recommended",
	],
	"pre-commit": {
		enabled: true,
	},
	customManagers: [
		{
			customType: "regex",
			description: "Update ROCm Validation Suite version in snapcraft.yaml",
			managerFilePatterns: ["/(^|/)snapcraft\\.yaml$/"],
			matchStrings: [
				"version:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
			],
			datasourceTemplate: "github-releases",
			depNameTemplate: "ROCm/ROCmValidationSuite",
			// Releases are tagged v<semver> (e.g. v1.7.0)
			extractVersionTemplate: "^v(?<version>.*)$",
			versioningTemplate: "semver",
		},
	],
	packageRules: [
		{
			matchPackageNames: ["ROCm/ROCmValidationSuite"],
			groupName: "ROCm Validation Suite",
			groupSlug: "rocm-validation-suite",
		},
		{
			matchPackageNames: ["zizmorcore/zizmor-pre-commit", "ghcr.io/zizmorcore/zizmor"],
			groupName: "zizmor",
			groupSlug: "zizmor",
		},
		{
			matchPackageNames: ["rhysd/actionlint"],
			groupName: "actionlint",
			groupSlug: "actionlint",
		},
	],
}
